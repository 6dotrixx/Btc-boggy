# ── Btc-boggy Kalshi bot — environment variables ──────────────────────────
# In Railway: worker service → Variables → + New Variable.
# The NAME goes in the left box, the VALUE in the right box. That's the #1
# mistake — the key code is a VALUE, not a name; the switches take the number 1.
#
# Paper mode (simulated money) needs NOTHING here. Add the Kalshi keys to
# verify your account, and the PM_LIVE switches only when you're ready to
# trade real money.

# ── Kalshi API keys (from kalshi.com → Account → API Keys → Create) ──────────
KALSHI_API_KEY_ID=your-key-id-uuid-here
KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...paste the whole key file text...\n-----END PRIVATE KEY-----"

# ── Live trading switches (leave unset for safe paper mode) ──────────────────
# PM_LIVE=1            # turns on real trading for the arbitrage bot
# PM_CRYPTO_LIVE=1     # turns on real trading for the crypto fair-value bot

# ── Optional tuning (sensible defaults already baked in) ─────────────────────
# PM_MAX_PER_TRADE=25          # max $ per trade
# PM_CRYPTO_RISK_FRAC=0.05     # crypto: fraction of bankroll per trade (5%)
# PM_DAILY_LOSS_FRAC=0.05      # stop trading for the day after a 5% loss
# PM_CRYPTO_EDGE_CENTS=4       # min model edge (cents) before a crypto trade
# PM_CANARY_TRADES=5           # first N live trades forced to 1 contract (~$0.50)
# PM_CRYPTO_MAX_VOL=0.004      # skip coins too volatile to price safely
# PM_CRYPTO_SERIES=KXBTC,KXBTCD,KXETH,KXETHD,KXSOL,KXSOLD,KXXRP,KXXRPD,KXDOGE,KXDOGED
# PM_SELFTEST=1                # run a real-API preflight test at startup

# ── Coinbase BTC bot (separate, optional — see COINBASE_GUIDE.md) ────────────
# CB_ENABLE=1                  # turn the BTC bot ON in paper mode (no keys needed)
# CB_API_KEY=your-coinbase-key
# CB_API_SECRET=your-coinbase-secret
# CB_LIVE=1                    # trade real money (requires the two keys above)
# TRADE_AMOUNT=20              # $ per BTC trade
# TAKE_PROFIT=0.05             # take profit at +5%
# STOP_LOSS=0.02               # stop loss at -2%
